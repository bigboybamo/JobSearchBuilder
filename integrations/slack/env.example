# Slack MCP Integration — Local Environment
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Bot User OAuth Token — starts with xoxb-
# Required scopes: channels:history, channels:read, chat:write,
#                  groups:history, groups:read, im:history,
#                  mpim:history, users:read
# Generate at: https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=

# Your Slack workspace Team ID — found in workspace settings URL
# Format: T followed by alphanumeric characters, e.g. T01AB2CD3EF
SLACK_TEAM_ID=

# ------------------------------------------------------------------
# CI/CD equivalent — set these as secrets in your pipeline, e.g.:
#
# GitHub Actions:
#   secrets.SLACK_BOT_TOKEN
#   secrets.SLACK_TEAM_ID
#
# Azure DevOps pipeline variables (secret):
#   $(SLACK_BOT_TOKEN)
#   $(SLACK_TEAM_ID)
# ------------------------------------------------------------------
