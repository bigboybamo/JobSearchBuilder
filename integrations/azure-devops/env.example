# Azure DevOps MCP Integration — Local Environment
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Full URL of your Azure DevOps organisation
# Format: https://dev.azure.com/{your-organisation}
AZURE_DEVOPS_ORG_URL=

# Authentication method — use 'pat' for local dev, 'azure-identity' for CI/CD
# Options: pat | azure-identity
AZURE_DEVOPS_AUTH_METHOD=pat

# Personal Access Token — used when AZURE_DEVOPS_AUTH_METHOD=pat
# Required scopes: Code (Read & Write), Work Items (Read & Write),
#                  Build (Read), Release (Read), Project and Team (Read)
# Generate at: https://dev.azure.com/{org}/_usersSettings/tokens
AZURE_DEVOPS_PAT=

# Default project name — used when no project is specified in a command
# Must match the project name exactly as it appears in Azure DevOps
AZURE_DEVOPS_DEFAULT_PROJECT=

# ------------------------------------------------------------------
# CI/CD equivalent:
#
# For CI/CD, switch AZURE_DEVOPS_AUTH_METHOD to 'azure-identity'
# and configure a managed identity or service principal instead of a PAT.
# The PAT variable can then be left empty.
#
# GitHub Actions:
#   secrets.AZURE_DEVOPS_ORG_URL
#   secrets.AZURE_DEVOPS_PAT          (or use azure-identity + OIDC)
#   secrets.AZURE_DEVOPS_DEFAULT_PROJECT
#
# Azure DevOps pipeline variables (secret):
#   $(AZURE_DEVOPS_ORG_URL)
#   $(AZURE_DEVOPS_PAT)
#   $(AZURE_DEVOPS_DEFAULT_PROJECT)
# ------------------------------------------------------------------
