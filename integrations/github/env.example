# GitHub MCP Integration — Local Environment
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Personal Access Token (classic) or Fine-grained PAT
# Required scopes: repo, read:org, read:user, read:project
# Generate at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# ------------------------------------------------------------------
# CI/CD equivalent — set these as secrets in your pipeline, e.g.:
#
# GitHub Actions:
#   secrets.GITHUB_PERSONAL_ACCESS_TOKEN
#
# Azure DevOps pipeline variable (secret):
#   $(GITHUB_PERSONAL_ACCESS_TOKEN)
# ------------------------------------------------------------------
