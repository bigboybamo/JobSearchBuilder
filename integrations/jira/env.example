# Jira MCP Integration — Local Environment
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Full URL of your Jira instance
# Cloud format:  https://{your-domain}.atlassian.net
# Server format: https://jira.{your-company}.com
JIRA_URL=

# Atlassian account email address associated with the API token
JIRA_USERNAME=

# Atlassian API token — not your account password
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Default project key — used when no project is specified in a command
# Format: short uppercase identifier, e.g. ACME, OPS, BACKEND
JIRA_DEFAULT_PROJECT_KEY=

# ------------------------------------------------------------------
# CI/CD equivalent — set these as secrets in your pipeline, e.g.:
#
# GitHub Actions:
#   secrets.JIRA_URL
#   secrets.JIRA_USERNAME
#   secrets.JIRA_API_TOKEN
#   secrets.JIRA_DEFAULT_PROJECT_KEY
#
# Azure DevOps pipeline variables (secret):
#   $(JIRA_URL)
#   $(JIRA_USERNAME)
#   $(JIRA_API_TOKEN)
#   $(JIRA_DEFAULT_PROJECT_KEY)
# ------------------------------------------------------------------
