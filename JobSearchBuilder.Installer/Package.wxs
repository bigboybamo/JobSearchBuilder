<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
	<Package
	  Name="!(loc.ProductName)"
	  Manufacturer="!(loc.Manufacturer)"
	  Version="1.0.0"
	  Language="1033"
	  UpgradeCode="469ab1dd-822f-45b3-bfdb-76a8c6aafb0a"
	  Compressed="yes">

		<SummaryInformation Description="JobSearchBuilder installer" />

		<MediaTemplate />

		<Icon Id="ProductIcon" SourceFile="..\JobSearchBuilder\Images\work-bag.ico" />
		<Property Id="ARPPRODUCTICON" Value="ProductIcon" />

		<ui:WixUI Id="WixUI_Minimal" />
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<Feature Id="MainFeature" Title="!(loc.ProductName)" Level="1">
			<ComponentGroupRef Id="JobSearchBuilderComponents" />
			<ComponentGroupRef Id="ShortcutComponents" />
		</Feature>

	</Package>
</Wix>
